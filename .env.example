# SerpAPI key for fetching product prices
SERPAPI_KEY=

# Your phone number for CallMeBot WhatsApp
PHONE_NUMBER=

# CallMeBot API key for sending messages
CALLMEBOT_KEY=

# Product query for SerpAPI
PRODUCT_QUERY=

# Maximum USD price to trigger the alert
PRICE_LIMIT_USD=

# Maximum CLP price to trigger the alert
PRICE_LIMIT_CLP=

# How often to check for prices (in hours)
CHECK_INTERVAL_HOURS=
